{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "OmniTransfer",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "dialog": { "all": true },
      "fs": { "all": true, "scope": ["$HOME/**"] },
      "path": { "all": true },
      "window": { "all": true }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "© 2024 MuazBinShafi",
      "identifier": "com.muazbinshafi.omnitransfer",
      "shortDescription": "Zero-config wireless file transfer",
      "longDescription": "OmniTransfer — cross-platform wireless file transfer using BLE discovery, AES-256-GCM encryption, BLAKE3 integrity verification, and Reed-Solomon FEC. Developed by MuazBinShafi.",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "externalBin": [],
      "resources": [],
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "wix": {
          "language": "en-US"
        },
        "nsis": {
          "installMode": "perMachine",
          "languages": ["English"]
        }
      },
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null,
        "minimumSystemVersion": "10.13"
      },
      "deb": {
        "depends": ["libc6", "libwebkit2gtk-4.0-37", "libssl3"],
        "section": "net",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "license": "MIT",
        "depends": ["glib2", "gtk3", "webkit2gtk3"],
        "release": "1"
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 768,
        "resizable": true,
        "title": "OmniTransfer",
        "width": 1024,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  }
}
